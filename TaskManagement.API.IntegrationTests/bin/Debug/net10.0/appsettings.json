{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=TaskManagementDb;User Id=sa;Password=sa_Password123!;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "TaskManagementIssuer",
    "Audience": "TaskManagementAudience",
    "Key": "Secret_Key_At_Least_32_Bytes_Long_For_Security_12345!",
    "ExpiryInMinutes": 15,
    "RefreshTokenExpiryInDays": 7
